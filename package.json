{
  "name": "sleekboard_server",
  "version": "1.0.0",
  "description": "Express + MongoDB API for SleekBoard",
  "main": "src/server.js",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "NODE_ENV=development node --watch src/server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:copy": "node src/scripts/copyFromMongo.js",
    "test:db": "node --env-file=.env --test --test-concurrency=1 \"test/**/*.pg.test.js\""
  },
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "http-status-codes": "^2.3.0",
    "openai": "^7.45.1",
    "pg": "^8.23.1",
    "pg-connection-string": "^2.14.1"
  },
  "devDependencies": {
    "mongoose": "^8.24.8",
    "prisma": "^7.10.1"
  }
}
